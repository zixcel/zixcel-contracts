      "path": ".github/workflows/publish-cargo.yml",
      "jobs": [
        {
          "job": "verify",
          "condition": "vars.REGISTRY_VALIDATION_ENABLED == 'true' && github.event.repository.private == false",
          "runs_on": "ubuntu-latest",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
              "condition": null
            },
            {
              "name": "Require the reviewed source",
              "run": "test \"$APPROVED_SHA\" = \"$GITHUB_SHA\"\nif [ \"$REGISTRY_OPERATION\" = publish ]; then\n  git merge-base --is-ancestor HEAD origin/main\nelse\n  git merge-base --is-ancestor origin/main HEAD\nfi\nrustup toolchain install 1.97 --profile minimal --component rustfmt --component clippy\nrustup override set 1.97\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Validate public package metadata",
              "run": "cargo metadata --locked --no-deps --format-version 1 > /tmp/package-metadata.json\nnode --input-type=module <<'JS'\nimport fs from 'node:fs';\nconst d = JSON.parse(fs.readFileSync('/tmp/package-metadata.json'));\nconst p = d.packages.find(p => p.manifest_path === `${process.env.GITHUB_WORKSPACE}/Cargo.toml`);\nif (!p || JSON.stringify(p.publish) !== '[\"crates-io\"]'\n  || p.repository !== `https://github.com/${process.env.GITHUB_REPOSITORY}`) {\n  throw new Error('Public package metadata is not the reviewed crate');\n}\nfs.appendFileSync(process.env.GITHUB_ENV, `PACKAGE_ARCHIVE=target/package/${p.name}-${p.version}.crate\\n`);\nfs.appendFileSync(process.env.GITHUB_OUTPUT, `version=${p.version}\\n`);\nJS\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Verify independent package build",
              "run": "cargo fmt --all -- --check\ncargo test --locked --all-features\ncargo clippy --locked --all-targets --all-features -- -D warnings\ncargo package --locked --registry crates-io\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Record the review artifact digest",
              "run": "sha256sum \"$PACKAGE_ARCHIVE\"\necho \"sha256=$(sha256sum \"$PACKAGE_ARCHIVE\" | cut -d ' ' -f 1)\" >> \"$GITHUB_OUTPUT\"\n",
              "uses": null,
              "condition": null
            },
            {
              "name": null,
              "run": null,
              "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
              "condition": null
            }
          ]
        },
        {
          "job": "publish",
          "condition": "inputs.operation == 'publish' && vars.REGISTRY_PUBLISH_ENABLED == 'true' && github.ref_type == 'tag'",
          "runs_on": "ubuntu-latest",
          "steps": [
            {
              "name": null,
              "run": null,
              "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
              "condition": null
            },
            {
              "name": "Require the approved tag and CI artifact",
              "run": "test \"$GITHUB_REF_NAME\" = \"v${VERSION}\"\ntest -n \"$APPROVED_SHA256\"\ntest \"$VERIFIED_SHA256\" = \"$APPROVED_SHA256\"\nrustup toolchain install 1.97 --profile minimal --component rustfmt --component clippy\nrustup override set 1.97\ncargo package --locked --registry crates-io\ntest \"$(sha256sum target/package/*.crate | cut -d ' ' -f 1)\" = \"$APPROVED_SHA256\"\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Obtain a short-lived scoped crates.io token",
              "run": null,
              "uses": "rust-lang/crates-io-auth-action@c6f97d42243bad5fab37ca0427f495c86d5b1a18",
              "condition": null
            },
            {
              "name": "Publish the approved crate",
              "run": "cargo publish --locked --registry crates-io",
              "uses": null,
              "condition": null
            }
          ]
        }
