{
  "repository": "zixcel/zixcel-contracts",
  "purpose": "Give integrations a shared vocabulary for requests and results so callers can validate service boundaries.",
  "responsibility_boundary": "Own the named reusable integration/data mechanism. Product roles/UI and operational approvals stay with consumers; transport/custody reuse managed Crowsi components where capabilities fit. Planning-only APIs must remain clearly distinguished from implemented external operations.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "zixcel-contracts",
      "ecosystem": "rust",
      "description": "Versioned wire contracts for independent Zixcel connectors",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "behavior_package::{\n    BehaviorArtifactRefV1, BehaviorEffectV1, BehaviorImplementationV1, BehaviorPackageV1,\n    parse_behavior_package_json,\n}",
          "error::{Validate, ValidationError}",
          "owner_recovery::{\n    DEFAULT_MOVE_RECEIPT_RETENTION_SECONDS, OwnerRecoveryMethodV1, OwnerRecoveryRequestV1,\n}",
          "plan::{ConnectorPlanV1, PlanEffectV1, PlanStepV1}",
          "receipt::{ConnectorReceiptV1, ReceiptArtifactV1, ReceiptStatusV1}",
          "request::{ConnectorRequestV1, RequestModeV1, SecretRefV1, parse_request_json}",
          "validation::reject_embedded_secrets",
          "workspace_action::{\n    WorkspaceActionRequestV1, WorkspaceActionV1, WorkspaceEffectV1, WorkspacePathV1,\n    parse_workspace_action_json,\n}",
          "workspace_projection_receipt::{\n    WorkspaceActionReceiptV2, WorkspaceArtifactReferenceV1, WorkspaceProjectionReferenceV1,\n    parse_workspace_receipt_v2_json,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "crates/bounded-io/Cargo.toml",
      "package": "zixcel-bounded-io",
      "ecosystem": "rust",
      "description": "Caller-budgeted physical intake; no owner, semantic or storage policy",
      "interfaces": {
        "lib": "crates/bounded-io/src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "errors::{InputLimit, InputType}",
          "files::{open_regular_file, read_directory, read_regular_file, read_regular_text}",
          "stream::{read_bounded, read_bounded_retrying}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "packages/management-contracts/package.json",
      "package": "@zixcel/management-contracts",
      "ecosystem": "npm",
      "description": "Versioned provider-neutral management metadata JSON Schemas",
      "interfaces": {
        "exports": {
          "./schemas/*.schema.json": "./schemas/*.schema.json"
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "validate": "node ./tools/validate-schemas.mjs",
        "test": "node --test test/repository.test.mts test/failure-boundaries.test.mts",
        "check": "npm run validate && npm test",
        "prepack": "npm run check"
      }
    }
  ],
  "schema_definitions": [
    "packages/management-contracts/schemas/connector-plan-v1.schema.json",
    "packages/management-contracts/schemas/ecosystem-handoff-report-v1.schema.json",
    "packages/management-contracts/schemas/local-observation-v1.schema.json",
