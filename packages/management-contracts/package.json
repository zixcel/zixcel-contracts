{
  "name": "@zixcel/management-contracts",
  "version": "0.1.1",
  "private": false,
  "description": "Versioned provider-neutral management metadata JSON Schemas",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "schemas",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./schemas/*.schema.json": "./schemas/*.schema.json"
  },
  "scripts": {
    "validate": "node ./tools/validate-schemas.mjs",
    "test": "node --test test/repository.test.mts test/failure-boundaries.test.mts",
    "check": "npm run validate && npm test",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixcel/zixcel-contracts.git",
    "directory": "packages/management-contracts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "typed-contracts",
    "schema-validation",
    "api-design",
    "rust"
  ]
}
